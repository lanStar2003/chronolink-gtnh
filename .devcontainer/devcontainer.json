{
  "name": "ChronoLink - GTNH 2.8.4 cloud development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteEnv": {
    "JAVA_HOME": "/opt/java/openjdk",
    "JAVA_HOME_8_X64": "/opt/java/jdk8",
    "JAVA_HOME_21_X64": "/opt/java/openjdk"
  },
  "postCreateCommand": "python3 scripts/gradle_bootstrap.py --version",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "forwardPorts": []
}
